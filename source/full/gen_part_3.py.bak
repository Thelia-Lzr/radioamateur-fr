# -*- coding: utf-8 -*-
import json, os

D = {}

D["20036"] = {
 "stem_zh": "RX 的阻值是多少？",
 "ans_zh": "10 Ω",
 "com_zh": "比例（乘积交叉）法：R = 15 × 6 / 9 = 10",
 "explain": r"此题需看图。图中给出 15 Ω、6 Ω、9 Ω 三个电阻，RX 待求，按注释的比例（乘积交叉）关系 \(R_X = 15\times6/9 = 10\ \Omega\)。这类结构满足 RX × 9 = 15 × 6，交叉相乘再除即可。干扰项 32.5 Ω 与 36 Ω 都是把交叉相乘的分子分母配错（该乘的当除、该除的当乘）得出的；「无法计算」是没注意到图里已经给足了三个数据。看图时先标出哪两个电阻在同一支路、哪个是待求项，再决定谁乘谁。",
}

D["20037"] = {
 "stem_zh": "计算 IR1",
 "ans_zh": "0.305 A",
 "com_zh": "2.2 kΩ 电阻中的电流：100/2200 = 0.04545 A；IR1 = IR – 0.04545 = 0.304545，取整为 0.305 A",
 "explain": r"此题需看图。图内 2.2 kΩ 支路两端加 100 V，总电流 IR = 350 mA。先算旁路支路电流 \(I = U/R = 100/2200 = 0.04545\ \text{A}\)，再由基尔霍夫电流定律从总电流里减掉它：\(I_{R1} = 0.35 - 0.04545 = 0.304545 \approx 0.305\ \text{A}\)。干扰项 0.045 A 就是旁路电流本身（漏了减法），350 mA 是总电流（没做减法），3.05 A 是小数点错位。并联电路里「总电流分流」是基本功。",
}

D["20038"] = {
 "stem_zh": "计算 IR1",
 "ans_zh": "10 mA",
 "com_zh": "IR2 = UR2 / R2 = 24 / 1200 = 0.02 A = 20 mA；IR1 = IT – IR2 = 30 – 20 = 10 mA",
 "explain": r"此题需看图。图中 R2 = 1200 Ω，其两端电压 24 V，总电流 IT = 30 mA。先用欧姆定律求 R2 支路电流 \(I_{R2} = 24/1200 = 0.02\ \text{A} = 20\ \text{mA}\)，再由分流关系 \(I_{R1} = I_T - I_{R2} = 30-20 = 10\ \text{mA}\)。干扰项 20 mA 是 R2 支路的电流（减错了对象），0.1 A 是同一数值的小数点错位（10 mA = 0.01 A），28 mA 没有来源。同一段并联电路里，一条支路电流越大，另一条就越小。",
}

D["20044"] = {
 "stem_zh": "1000 Hz 信号的角频率是多少？",
 "ans_zh": "6280",
 "com_zh": "角频率 = 2 × π × F = 2 × 3.14 × 1000 = 6280",
 "explain": r"角频率 \(\omega = 2\pi f = 2\times3.14\times1000 = 6280\ \text{rad/s}\)，单位是弧度每秒而不是赫兹。干扰项 628 是漏乘了 2π 里的那个 2，6.28 只算到 2π 就停了，0.001 是把频率取了倒数（那是周期 1 ms 的数值）。记住一条：角频率永远比频率大 6.28 倍，先乘 2π 再报数。凡是问角频率，答数一定是频率的 6.28 倍；若算出来比频率还小，就是把倒数关系用错了。",
}

D["20046"] = {
 "stem_zh": "周期为 500 微秒的信号的频率是多少？",
 "ans_zh": "2 kHz",
 "com_zh": "500 µs = 0.0005 秒；F = 1/t = 1 / 0.0005 = 2000 Hz = 2 kHz",
 "explain": r"由 \(F = 1/T\) 出发，先统一单位：500 µs = 0.0005 s，于是 \(F = 1/0.0005 = 2000\ \text{Hz} = 2\ \text{kHz}\)。干扰项 4 kHz 是把它当成一半的周期，200 Hz 是把微秒误当毫秒（差一千倍），20 000 Hz 是小数点错位十倍。微秒、毫秒换算错一位答案就差一千倍，一定先把单位写成秒再取倒数。反向自检：1 kHz 的周期是 1 ms，频率乘 10、周期就除以 10，所以 10 kHz 必然对应 100 µs。",
}

D["20047"] = {
 "stem_zh": "周期为 500 毫秒的信号的频率是多少？",
 "ans_zh": "2 Hz",
 "com_zh": "500 ms = 0.5 s；F = 1/t = 1 / 0.5 = 2",
 "explain": r"500 ms = 0.5 s，\(F = 1/T = 1/0.5 = 2\ \text{Hz}\)。频率与周期互为倒数：周期越长，频率越低。干扰项 2 kHz 是把毫秒当成微秒（快了一千倍），0.2 Hz 是把倒数算成了 1/5，20 Hz 是小数点错位。只要先写出 T = 0.5 s 这一行，后面的倒数就很难错。另一种检查法：500 ms 的周期只可能对应几赫兹的低频，答案若落在 kHz 量级就说明单位跑偏了。",
}

D["20048"] = {
 "stem_zh": "频率为 10 千赫的信号的周期是多少？",
 "ans_zh": "100 µs",
 "com_zh": "t = 1/F = 1 / 10000 = 0.0001 = 0.1 ms = 100 µs",
 "explain": r"\(T = 1/F = 1/10000\ \text{s} = 0.0001\ \text{s} = 0.1\ \text{ms} = 100\ \mu\text{s}\)。干扰项 0.001 s 对应 1 kHz（少了一个零），10 µs 差十倍，10 ms 对应的是 100 Hz。可以记一组对应关系：1 kHz ↔ 1 ms，10 kHz ↔ 100 µs，100 kHz ↔ 10 µs，换算时不用每次重算。再说一遍单位：0.1 ms 与 100 µs 是同一个数，答 10 µs 或 1 ms 都差了十倍，看到频率先估量级再动笔。这类题其实只考两个动作：把频率写成 10 的幂，再取倒数，最后把秒换成毫秒或微秒。",
}

D["20049"] = {
 "stem_zh": "频率为 10 赫兹的信号的周期是多少？",
 "ans_zh": "100 ms",
 "com_zh": "t = 1/F = 1 / 10 = 0.1 s = 100 ms",
 "explain": r"\(T = 1/F = 1/10 = 0.1\ \text{s} = 100\ \text{ms}\)。低频对应长周期，10 Hz 的周期就是 0.1 秒。干扰项 1 ms 对应 1 kHz，10 ms 对应 100 Hz（小数点差一位），0.01 s 是把它当成 1/100。用「1 Hz ↔ 1 s」这把尺子量：频率每乘 10，周期就除以 10。另一个检查点：10 Hz 已低于音频下限，周期必然在几十到几百毫秒之间，答 1 ms（对应 1 kHz）就是量级跑偏。",
}

D["20053"] = {
 "stem_zh": "10 赫兹的信号的周期是多少？",
 "ans_zh": "100 ms",
 "com_zh": "t = 1/F = 1 / 10 = 0.1 s = 100 ms",
 "explain": r"同一条公式：\(T = 1/F = 1/10 = 0.1\ \text{s}\)，换算成毫秒就是 100 ms。干扰项 1000 ms = 1 s 是把它当成 1 Hz，10 ms 是 100 Hz 的值（小数点差一位），0.1 ms 差一千倍。做这类题先把 1/F 写成以秒为单位，再按 1 s = 1000 ms 换算，避免在单位和数量级之间来回跳。注意 1000 ms 恰好就是 1 秒，那是 1 Hz 的周期；ms 与 s 只差一位小数点，数量级却差一千倍。",
}

D["20054"] = {
 "stem_zh": "信号的频率是多少（5 ms/格）？",
 "ans_zh": "50 Hz",
 "com_zh": "观察窗口持续 8 × 5 ms = 40 ms，其中有 2 个周期，故每周期 20 ms，频率为 50 Hz（= 1 / 0.02）",
 "explain": r"此题需看图（示波器波形）。图中时基为 5 ms/格，水平方向共 8 格即 40 ms，这段时间里恰好有 2 个完整周期：\(T = 40/2 = 20\ \text{ms}\)，\(F = 1/0.02 = 50\ \text{Hz}\)。看图方法是先读「一格多少毫秒」，再数「一个周期占几格」。干扰项 200 Hz 是直接把 5 ms/格取倒数，100 Hz 是把 4 格误当成一个周期。别跳过「数格」这一步。",
}

D["20055"] = {
 "stem_zh": "100 Hz 的信号对应：\n1) 周期为 10 毫秒\n2) 波长为 300 千米\n3) 角频率为 628 弧度每秒\n4) 周期为 100 秒",
 "ans_zh": "1 和 3",
 "com_zh": "1 —— 正确（1/100 = 0.01 = 10 ms）；2 —— 错误：100 Hz 对应的波长是 3.000 km；3 —— 正确：角频率 = 2 × π × F = 6.28 × 100 = 628 rad/s；4 —— 错误，见第 1 条（t = 10 ms）",
 "explain": r"逐条判断：① \(T = 1/100 = 0.01\ \text{s} = 10\ \text{ms}\)，成立；② 波长要用 \(\lambda = 300/f(\text{MHz})\)，先把 100 Hz 换成 0.0001 MHz：\(\lambda = 300/0.0001 = 3000\ \text{km}\)，题中 300 km 差 10 倍，不成立；③ \(\omega = 2\pi f = 6.28\times100 = 628\ \text{rad/s}\)，成立；④ 周期是 10 ms 而不是 100 s，不成立。所以只有 1 和 3 对。干扰项「1 和 2」正是绊在波长那个数量级上：赫兹换兆赫要除以 \(10^6\)。组合型题的通用做法：先把四条命题各自独立算出数值，再回头比对说法，别被选项的排列（1 和 2、2 和 4 之类）牵着走。",
}

D["20056"] = {
 "stem_zh": "有效值为 12 V 的信号的峰值是多少？",
 "ans_zh": "17 V",
 "com_zh": "12 × 1.414 = 17 V（已取整）",
 "explain": r"峰值由有效值乘 1.414：\(U_{\text{crête}} = 12\times1.414 \approx 17\ \text{V}\)。干扰项 8.5 V 是乘了 0.707，方向弄反（那是峰值化有效值）；24 V 是 12×2，把峰值当成了峰峰值的一半；34 V 相当于把 1.414 乘了两遍。记住 \(\text{峰值}=\text{有效值}\times1.414\)、\(\text{有效值}=\text{峰值}\times0.707\)，先分清题目给的是哪一种。量级自检：正弦波的有效值约为峰值的 0.7，所以峰值必然略大于有效值，12 V 的答案落在 16～18 V 之间才合理。",
}

D["20057"] = {
 "stem_zh": "10 伏有效值时，峰值电压是多少？",
 "ans_zh": "14.14 V",
 "com_zh": "Umax = Ueff × 1.414 = 14.14 V",
 "explain": r"\(U_{\text{max}} = U_{\text{eff}}\times1.414 = 10\times1.414 = 14.14\ \text{V}\)。干扰项 7.07 V 是乘了 0.707（有效值与峰值的系数用反），20 V 是乘以 2（把峰值直接翻倍当峰峰值），28.28 V = 10×2.828 相当于连乘两遍系数。这类题只有一个动作：看清给的是有效值、峰值还是峰峰值，再决定用 1.414、0.707 还是 2.828。自检：峰值总比有效值大四成左右，10 V 的答案应在 14 V 附近，出现 7 V 或 20 V 都说明系数用错了。",
}

D["20058"] = {
 "stem_zh": "有效值为 5 V 的信号的峰值电压是多少？",
 "ans_zh": "7.07 V",
 "com_zh": "Umax = Ueff × 1.414 = 7.07 V",
 "explain": r"\(U_{\text{max}} = 5\times1.414 = 7.07\ \text{V}\)。干扰项 3.53 V 是 5×0.707（系数用反），14.14 V 正好是峰峰值 \(2\times7.07\)，6 V 只是随手凑的近似值。三个量的关系要记牢：\(\text{峰峰值} = 2\times\text{峰值} = 2.828\times\text{有效值}\)；题目问「峰值」就绝不能报峰峰值。数值感觉：峰值只比有效值大四成，5 V 的答案应在 7 V 上下；14.14 V 是峰峰值，3.53 V 是系数用反。",
}

D["20059"] = {
 "stem_zh": "峰峰值为 622 V 的电压，有效值是多少？",
 "ans_zh": "220 V",
 "com_zh": "Umax = Ucac / 2 = 622 / 2 = 311；Ueff = Umax × 0.707 = 220 V（取整）",
 "explain": r"选 220 V。峰峰值是正负两个峰之间的距离，先除以 2 得峰值 311 V，再乘 0.707 得有效值 \(U_{\text{eff}} = 311\times0.707 \approx 220\ \text{V}\)。也可一步到位：\(U_{\text{eff}} = U_{\text{càc}}\times0.707/2 = U_{\text{càc}}/(2\sqrt{2})\)。干扰项 311 V 是只做了一半（当成峰值），439.8 V 是把它当峰值又乘了 1.414。记住有效值的定义：与它产生同样热效应的直流值。三步口诀：先折半把峰峰值变峰值，再乘 0.707 得有效值，最后核对量级。",
}

D["20061"] = {
 "stem_zh": "峰峰值为 96 V 的电压，有效值是多少？",
 "ans_zh": "34 V",
 "com_zh": "96 Vcàc = 48 Vmax；48 Vmax × 0.707 = 33.94，取整为 34 Veff",
 "explain": r"先把峰峰值折半得峰值 \(U_{\text{max}} = 96/2 = 48\ \text{V}\)，再乘 0.707 得有效值 \(U_{\text{eff}} = 48\times0.707 = 33.94 \approx 34\ \text{V}\)。一步式：\(U_{\text{eff}} = U_{\text{càc}}/(2\sqrt{2})\)。干扰项 68 V 是 96×0.707（漏了折半），136 V 是 96×1.414（既漏折半又乘反），272 V 是 96×2.828。在纸上先写「折半 → 乘 0.707」两步再动笔。量级自检：96 V 峰峰值对应不到 50 V 的峰值、约 34 V 的有效值，即峰峰值的 0.3535 倍。遇到峰峰值先在纸上画一条横轴：上峰到下峰是峰峰值，中间到上峰才是峰值，看清问的是哪一段再套系数。",
}

D["20062"] = {
 "stem_zh": "75 Ω 同轴电缆上 20 W 信号的峰值电压是多少？",
 "ans_zh": "55 V",
 "com_zh": "U = √(P × R) = √(1500) = 39 V（有效值，已取整）= 55 V 峰值。\n假定没有驻波。",
 "explain": r"用功率和阻抗求电压：\(U_{\text{eff}} = \sqrt{PR} = \sqrt{20\times75} = \sqrt{1500} \approx 38.7\ \text{V}\)，再乘 1.414 得峰值 \(38.7\times1.414 \approx 55\ \text{V}\)。干扰项 39 V 是只算到有效值就收手，110 V 是把 55 又乘了 2，75 V 直接把阻抗数值搬来当电压。这类题先确认问的是有效值还是峰值，两个都要算，单位里就藏着得分点。量级检查：20 W 在 75 Ω 上只有几十伏的电压量级，110 V 已接近峰峰值的两倍，明显偏大。",
}

D["20063"] = {
 "stem_zh": "50 Ω 同轴电缆上 40 W 信号的峰值电流是多少？",
 "ans_zh": "1.27 A",
 "com_zh": "I = √(P / R) = √(40 / 50) = 0.9 A（有效值）= 1.27 A（峰值，已取整）。\n假定没有驻波。",
 "explain": r"由功率求电流：\(I_{\text{eff}} = \sqrt{P/R} = \sqrt{40/50} = 0.894\ \text{A}\)，再乘 1.414 得峰值 \(0.894\times1.414 \approx 1.27\ \text{A}\)。干扰项 0.9 A 停在有效值，45 A 是把公式写成 \(\sqrt{P\times R}\)（除以 R 变成了乘 R），32 A 是数量级被放大的错位结果。同轴线上电压、电流、功率只要记住 \(P = U^2/R = RI^2\) 就能互相推。量级检查：40 W 除以 50 Ω 再开方，结果必然是零点几安的小电流，45 A 一眼就不合理。",
}

D["20066"] = {
 "stem_zh": "电容器的电容量由哪些因素决定？",
 "ans_zh": "1 和 4",
 "com_zh": "构成极板的材料以及所加的电压对电容器的容量没有任何影响。",
 "explain": r"此题需看图：图中列出 4 条命题，注释已点明「极板材料」与「所加电压」不影响电容值，即落在两条假命题上；剩下的 1 与 4 对应真正决定电容量的因素，所以选 1 和 4。原理是平行板电容公式 \(C = \varepsilon S/d\)：容量只由极板面积 S、极板间距 d 和介质的介电常数 ε 决定，与极板用什么金属、加多大电压无关。做法是先给每条命题贴标签——落在「面积 / 间距 / 介质」上为真，落在「材料 / 电压 / 电流」上为假。",
}

D["20067"] = {
 "stem_zh": "电容器的电容量由哪些因素决定？",
 "ans_zh": "2 和 3",
 "com_zh": "信号的频率与功率对电容器的容量没有任何影响。",
 "explain": r"此题需看图（图中 4 条命题）。注释说「频率」和「功率」不影响电容值，这两条就是假命题，剩下 2 和 3 为真，对应真正决定电容的几何与介质因素。依据仍是 \(C = \varepsilon S/d\)：电容由极板面积、间距和介电常数决定，与工作频率、信号功率、外加电压都无关。这里最容易混的是容抗 \(Z_C = 1/(2\pi fC)\)：它随频率升高而下降，但电容 C 本身是器件的固有参数，不随频率变。",
}

D["20068"] = {
 "stem_zh": "电容器的电容量由哪些因素决定？",
 "ans_zh": "3 和 4",
 "com_zh": "命题 3 与命题 4 表达的是同一件事。",
 "explain": r"此题需看图（图中 4 条命题）。注释的关键线索是命题 3 与 4「意义相同」，也就是它们描述的是同一个决定因素，必然同真同假；结合答案选 3 和 4，可知这两条才是真正影响电容量的说法。判断依据还是 \(C = \varepsilon S/d\)。组合型题的套路：先把每条命题归类到「面积 / 间距 / 介质」（真）或「材料 / 电压 / 频率 / 功率」（假），再看注释给的提示，就不会被选项里的排列组合绕晕。",
}

D["20071"] = {
 "stem_zh": "把平板电容器两极板之间的距离加倍，会怎样？",
 "ans_zh": "电容量除以 2",
 "com_zh": "",
 "explain": r"平行板电容 \(C = \varepsilon S/d\)，容量与极板间距成反比：间距加倍则容量减半。干扰项「乘以 2」把反比当成了正比，「不变」忽略了 d 出现在分母上，「变为 4 倍」是把线圈电感与匝数的平方关系 \(L \propto N^2\) 错套到电容上。记法：面积越大容量越大，间距越大容量越小，两个都是一次关系，不带平方。",
}

D["20075"] = {
 "stem_zh": "等效容量是多少？",
 "ans_zh": "300 µF",
 "com_zh": "1200 / 4 = 300",
 "explain": r"此题需看图：图中是 4 个相同的 1200 µF 电容串联。串联电容 \(1/C_T = \sum 1/C_i\)，n 个相同电容串联时 \(C_T = C/n = 1200/4 = 300\ \mu\text{F}\)。串联后等效容量必然小于其中最小的那个电容，这是最快的排除法：4800 µF 反而变大，正是把串联当并联（1200×4）算出来的；4.8 mF、480 µF 是单位或数量级写错。",
}

D["20076"] = {
 "stem_zh": "等效容量是多少？",
 "ans_zh": "5.5 nF",
 "com_zh": "33 / 6 = 5.5",
 "explain": r"此题需看图：6 个 33 nF 的电容串联，用相同元件串联公式 \(C_T = C/n = 33/6 = 5.5\ \text{nF}\)。串联容量只会变小，所以 198 nF 这种变大的答案一定是误用了并联相加（33×6）；33 nF 是根本没做合并；550 µF 差了单位量级。规则一句话：并联直接相加，串联用倒数和，相同元件串联就除以个数。",
}

D["20077"] = {
 "stem_zh": "等效容量是多少？",
 "ans_zh": "45 µF",
 "com_zh": "Ceq = C1 + C2 = 12 + 33 = 45",
 "explain": r"此题需看图：图中 12 µF 与 33 µF 两个电容并联，并联直接相加 \(C_T = 12+33 = 45\ \mu\text{F}\)。干扰项 8.8 µF 正是把它们按串联算的结果 \(\frac{12\times33}{12+33} = 8.8\)，88 µF 是小数点错位，45 mF 是把 µF 写成了 mF（差 1000 倍）。记法：电容并联像电阻串联，直接加；电容串联像电阻并联，用积比和。顺带记牢：电容并联用加法、串联用 1/C 求和，与电阻正好相反。",
}

D["20078"] = {
 "stem_zh": "等效容量是多少？",
 "ans_zh": "1500 pF",
 "com_zh": "CT = C1 + C2 = 1500 pF，即 1.5 nF",
 "explain": r"此题需看图：两电容并联，注释给出其和为 1500 pF。并联公式 \(C_T = C_1 + C_2 = 1500\ \text{pF} = 1.5\ \text{nF}\)（1 nF = 1000 pF）。干扰项 333 pF 比总量还小，说明有人按串联算了；1.05 nF 与 501 nF 是单位换算混乱的产物。自检标准很简单：等效容量绝不会小于并联支路中最大的那个电容。另外把 1 nF = 1000 pF 这个换算练熟：1500 pF 写成 1.5 nF，两种写法都要认得。",
}

D["20079"] = {
 "stem_zh": "等效容量是多少？",
 "ans_zh": "0.5 nF",
 "com_zh": "并联部分：2 × 500 pF = 1 nF；再与 1 nF 的电容器串联：1 nF / 2 = 0.5 nF",
 "explain": r"此题需看图：两个 500 pF 先并联，再与一个 1 nF 串联。第一步并联相加：\(500+500 = 1000\ \text{pF} = 1\ \text{nF}\)；第二步两个 1 nF 串联：\(C_T = \frac{1\times1}{1+1} = 0.5\ \text{nF}\)。干扰项 2 nF 是把三个电容全当并联相加，1250 pF 是串并联混算，50 pF 差十倍。混合电路先化简单环节，串、并联分步套公式，别想一步到位。自检：结果 0.5 nF 比串在外面的 1 nF 还小，符合串联必减小的规律。",
}

D["20082"] = {
 "stem_zh": "要在 20 pF 的电容器上得到 25 pF，应该怎么做？",
 "ans_zh": "并联一个 5 pF 的电容器",
 "com_zh": "要增大等效容量，就必须并联一个电容器。\n公式：CT = C1 + C2",
 "explain": r"目标 25 pF 比原有的 20 pF 大，而串联只会让等效容量小于参与串联的最小电容，所以两个「串联」选项直接出局。并联相加：\(C_T = 20+5 = 25\ \text{pF}\)，答案就是并联 5 pF。干扰项「并联 11 pF」会得到 31 pF（多加了 6 pF），「串联 11 pF」算出 \(\frac{20\times11}{31} \approx 7.1\ \text{pF}\)，方向完全反了。记法：并联越并越大，串联越串越小。",
}

D["20084"] = {
 "stem_zh": "Z = ？（阻抗是多少？）（⚠️待核）",
 "ans_zh": "0.000 227 Ω",
 "com_zh": "Z = 1 / (2 × π × F × C)，或写成 Z（欧姆）= 159 / F(MHz) / C(nF) = 159 / 7 / 100 000 = 0.000 227",
 "explain": r"此题需看图（题干只剩「Z = ?」，电路与数据都在图里；按注释算式，图中应为 F = 7 MHz 的电容支路，容量代入值 100 000）。按注释计算：容抗 \(Z_C = \frac{1}{2\pi fC}\)，实用简化式 \(Z(\Omega) = \frac{159}{F(\text{MHz})\cdot C(\text{nF})}\)，代入得 0.000 227 Ω。关键在于容量单位必须与所选公式配套：159 简化式要求 C 取 nF。若把 100 000 pF（= 100 nF）按其数值直接代入会得 0.227 Ω，若按 100 pF 代入则得 227 Ω——正好差一千倍，所以选项里 227 Ω 就是单位换错的典型陷阱，22 mΩ 量级更离谱。另记：容抗随频率升高而下降，别把方向记反。",
}

D["20086"] = {
 "stem_zh": "电容器引入的相移是多少？",
 "ans_zh": "− 90°",
 "com_zh": "电压相对电流滞后（−90°）：先有电流，后有电压",
 "explain": r"电容器上电流超前电压 90°，也就是电压相对电流滞后 90°，记作 −90°。记忆钩子：电容「先电流后电压」（电流领先），与其对偶的电感是 +90°（电压领先）。干扰项 180° 是倒相（例如共射放大级或变压器反接），「无相移」是纯电阻的特性，+90° 是电感的答案。容抗公式 \(|Z_C| = 1/(2\pi fC)\) 只能算大小，方向要靠「电流领先」这条规则补上。",
}

D["20087"] = {
 "stem_zh": "如果在线圈上把匝数加倍，会发生什么？",
 "ans_zh": "线圈的电感量变为 4 倍",
 "com_zh": "这在线圈形状不变的前提下成立，而形状不变实际上很难做到……",
 "explain": r"电感量与匝数的平方成正比（\(L \propto N^2\)），所以匝数加倍，电感量变成 \(2^2 = 4\) 倍。干扰项「加倍」是把平方关系当成了线性关系，「除以 2」「除以 4」方向反了。注释提醒「形状不变」这个前提现实中很难满足——匝数变多，线圈通常也会变长变大，实际倍率会偏离 4，但考试考的就是那条平方定律。顺带记：L 变大后，谐振频率 \(f = 1/(2\pi\sqrt{LC})\) 会下降。",
}

D["20091"] = {
 "stem_zh": "正确的公式是哪一个？",
 "ans_zh": "t(s) = L / R",
 "com_zh": "对于电容器，正确的公式是：t(s) = R × C",
 "explain": r"题干只写了「正确的公式」，结合四个选项和注释可知问的是时间常数 τ（秒）。RC 电路配电容，\(\tau = RC\)；RL 电路配线圈，\(\tau = L/R\)，所以答案是 \(t(s) = L/R\)。最好的自检是量纲：Ω×F = 秒、H/Ω = 秒都成立，而 R/C、R/L、\(1/(RC)\) 都得不到秒，量纲一验就排除。记法：电容配 R 用乘，线圈配 R 用除。",
}

D["20095"] = {
 "stem_zh": "初级电流是多少？",
 "ans_zh": "1 A",
 "com_zh": "初级功率 = 次级功率 = 100 W，初级电压 = 100 V，故 I = P / U = 1 A。变压器的特性参数（匝数）在这道题中无用。",
 "explain": r"此题需看图：图中初级加 100 V，次级负载消耗 100 W。理想变压器功率守恒 \(P_1 = P_2\)，所以初级电流 \(I_1 = P_1/U_1 = 100/100 = 1\ \text{A}\)。匝数比在这里是纯干扰——功率守恒已经给出全部信息，不必去算电压比。干扰项 400 mA 与 10 mA 是小数量级错位，2.5 A 是拿别的电压去除 100 W。做题先问：功率给了没有？给了就不用匝数。",
}

D["20096"] = {
 "stem_zh": "次级电流是多少？",
 "ans_zh": "4 A",
 "com_zh": "初级功率 = 次级功率；次级电流 I = P / U = 300 / 75 = 4",
 "explain": r"此题需看图：图中功率 300 W、次级电压 75 V。理想变压器 \(P_2 = P_1\)，于是次级电流 \(I_2 = P_2/U_2 = 300/75 = 4\ \text{A}\)。干扰项 0.4 A 是把 300 除以 750（小数点错位），200 mA 与 4 mA 是小数量级错位。变压器题的固定动作：先确认功率（或由 P = UI 求出），再套功率守恒，匝数比只在题目不给功率时才需要。",
}

D["20097"] = {
 "stem_zh": "流过电阻的电流是多少？",
 "ans_zh": "2 A",
 "com_zh": "初级功率 = 次级功率，故 I = P / U，即 100 W / 50 V = 2 A",
 "explain": r"此题需看图：次级电阻上加 50 V，其消耗功率 100 W。由理想变压器 \(P_1 = P_2\) 知次级功率也是 100 W，电流 \(I = P/U = 100/50 = 2\ \text{A}\)。干扰项 0.5 A 恰是 50/100——把除法上下颠倒了，25 A 与 200 mA 是量级和小数点错位。牢记 \(P = UI\) 的两个变形 \(I = P/U\)、\(U = P/I\)，落笔前先确认已知的是哪两个量。量级自检：100 W 除以 50 V 得 2 A，属于几安的合理量级；若图中还给了电阻值，用 \(P = RI^2\) 应能对回同一个功率。",
}

D["20099"] = {
 "stem_zh": "流过电阻 R 的电流是多少？",
 "ans_zh": "0.1 A",
 "com_zh": "次级电压 = 220 × (100 / 1000) = 220 / 10 = 22；I = U / R = 22 / 220 = 0.1 A",
 "explain": r"此题需看图：初级 220 V，匝数比 1000:100，负载电阻 220 Ω。先用电压比 \(\frac{U_2}{U_1} = \frac{N_2}{N_1}\) 得 \(U_2 = 220\times\frac{100}{1000} = 22\ \text{V}\)，再用欧姆定律 \(I = U_2/R = 22/220 = 0.1\ \text{A}\)。干扰项 1 A 是漏掉匝比直接 220/220，10 A 与 10 mA 是十倍和小数点错位。先变压、再欧姆，这类题一律分两步。量级检查：220 V 经 10:1 降压得 22 V，加在 220 Ω 上只有 0.1 A；答 10 A 意味着两千多瓦的功率，与这个小变压器完全不符。",
}

D["20100"] = {
 "stem_zh": "电阻 R 上耗散的功率是多少？",
 "ans_zh": "35 W",
 "com_zh": "设变压器为理想变压器，故 Ps = Pp = Up × Ip = 100 × 0.35；Ns 与 Np 的数值对解这道题无用。",
 "explain": r"此题需看图：初级 100 V、0.35 A。理想变压器功率守恒，\(P = U_1I_1 = 100\times0.35 = 35\ \text{W}\)，这 35 W 全部送到次级，也就是电阻 R 上耗散的功率（若图中还给了 R 的阻值，可用 \(P = RI^2\) 或 \(U^2/R\) 交叉验证）。匝数比是干扰信息。干扰项 350 mW 与 3.5 W 是小数点错位，350 W 放大了 10 倍；量级自检：100 V 乘零点几安的电流，结果必然在几十瓦。",
}

D["20102"] = {
 "stem_zh": "初级的阻抗是多少？",
 "ans_zh": "3600 Ω",
 "com_zh": "假定变压器为理想变压器，N = 匝数比 = 1/30；Ze = Zs / N² = 4 / (1/30)² = 4 × 30 × 30 = 3600 Ω",
 "explain": r"此题需看图：次级接 4 Ω 负载，匝数比 \(N = N_2/N_1 = 1/30\)。阻抗按匝数比的平方变换：\(Z_1 = Z_2/N^2 = 4/(1/30)^2 = 4\times900 = 3600\ \Omega\)。干扰项 120 Ω 是只乘了一次 30（忘了平方），4 Ω 是根本没做变换，270 Ω 是把平方关系用反的结果。口诀：电压按匝比变，阻抗按匝比平方变；方向拿不准就用「折算到初级一侧，1:30 降压会显得阻抗更大」来自检。",
}

D["20103"] = {
 "stem_zh": "初级的阻抗是多少？",
 "ans_zh": "200 Ω",
 "com_zh": "假定变压器为理想变压器，N = 匝数比 = 300/1500 = 0.2；Zs = Ze / N² = 8 / 0.2 / 0.2 = 200",
 "explain": r"此题需看图：次级负载 8 Ω，匝数比 \(N = 300/1500 = 0.2\)。\(Z_1 = Z_2/N^2 = 8/0.2^2 = 8/0.04 = 200\ \Omega\)。干扰项 40 Ω 是只除了一次 0.2（漏平方），1.6 Ω 是乘 0.2（方向弄反且没平方），320 Ω 是平方关系算反。量级自检：8 Ω 经过 1:5 的降压变压器折算到初级，阻抗要放大 \(5^2 = 25\) 倍，\(8\times25 = 200\ \Omega\)，先估量级再动手。可对照另一道同类型题目：降压变压器把次级负载折算到初级，阻抗总是变大的，方向别搞反。",
}

if __name__ == "__main__":
    base = os.path.dirname(os.path.abspath(__file__))
    src = json.load(open(os.path.join(base, "in_3.json"), encoding="utf-8"))
    src_nums = [e["num"] for e in src]
    out = os.path.join(base, "out_part_3.json")
    with open(out, "w", encoding="utf-8") as f:
        json.dump(D, f, ensure_ascii=False, indent=1)
    chk = json.load(open(out, encoding="utf-8"))
    keys = sorted(chk.keys())
    assert len(chk) == 39, len(chk)
    print("keys:", len(keys))
    print(keys)
    missing = [n for n in src_nums if n not in chk]
    extra = [n for n in chk if n not in src_nums]
    print("missing:", missing)
    print("extra:", extra)
    for n in keys:
        for k in ("stem_zh", "ans_zh", "com_zh", "explain"):
            assert k in chk[n], (n, k)
        assert chk[n]["stem_zh"], n
        assert chk[n]["ans_zh"], n
        assert chk[n]["explain"], n
    # 与源 option 对齐校验：答案必须能对上 ans_fr 的语义线索
    bad = [n for n in keys if len(chk[n]["explain"]) < 80]
    print("short explain:", bad)
    print("OK", out)
