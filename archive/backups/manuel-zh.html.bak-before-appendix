<tr><td>第 1 个选项</td><td>703</td><td>26,1%</td></tr>
<tr><td>第 2 个选项</td><td>669</td><td>24,9%</td></tr>
<tr><td><b>第 3 个选项</b></td><td><b>748</b></td><td><b>27,8%</b></td></tr>
